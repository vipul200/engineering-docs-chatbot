# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 1 = no LLM calls (extractive answers only)
AIP_OFFLINE=0
# Set to 0 when calling Claude via Bedrock / Vertex / an API gateway
AIP_SERVER_FALLBACKS=1
# Point at your own markdown docs
AIP_DOCS_DIR=data/docs
# Optional: require X-API-Key on /chat
AIP_API_KEY=
