{
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "history": {
            "description": "Prior turns, oldest first. Only the last 6 are used.",
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "maxItems": 20,
            "title": "History",
            "type": "array"
          },
          "question": {
            "examples": [
              "How do I roll back a production deploy?"
            ],
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "flags": {
            "description": "e.g. pii_masked, possible_prompt_injection, low_grounding",
            "items": {
              "type": "string"
            },
            "title": "Flags",
            "type": "array"
          },
          "grounding": {
            "description": "Share of answer text backed by citations.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Grounding",
            "type": "number"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "enum": [
              "answered",
              "not_found",
              "ungrounded",
              "rejected",
              "extractive"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "answer",
          "status",
          "sources",
          "grounding",
          "flags"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "ChatTurn": {
        "properties": {
          "content": {
            "maxLength": 4000,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "pattern": "^(user|assistant)$",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "chatbot_loaded": {
            "title": "Chatbot Loaded",
            "type": "boolean"
          },
          "llm_enabled": {
            "title": "Llm Enabled",
            "type": "boolean"
          },
          "llm_model": {
            "title": "Llm Model",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "chatbot_loaded",
          "llm_enabled",
          "llm_model"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SourceOut": {
        "properties": {
          "citation": {
            "description": "'<file> > <section>'",
            "title": "Citation",
            "type": "string"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Exact text Claude cited from this source.",
            "title": "Quote"
          },
          "score": {
            "description": "Retrieval similarity (0-1).",
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "citation",
          "score"
        ],
        "title": "SourceOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Engineering Docs Chatbot",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/chat": {
      "post": {
        "operationId": "chat_chat_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing/invalid X-API-Key (only when AIP_API_KEY is set)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "No documents loaded"
          }
        },
        "summary": "Chat"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
